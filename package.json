	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"test": "jest",
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"format": "biome format --write ./src ./tests",
		"prepare": "husky"
	},
	"dependencies": {
		"@heroicons/react": "^2.1.4",
		"@hookform/resolvers": "^3.9.0",
		"@radix-ui/react-accordion": "^1.2.0",
