{
	"files": [],
	"references": [
		{ "path": "./tsconfig.app.json" },
		{ "path": "./tsconfig.node.json" }
	],
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"]
		},
		"moduleResolution": "node",
		"esModuleInterop": true,
		"skipLibCheck": true, // Ignora errores de tipado en archivos de biblioteca
		"noEmitOnError": false, // Permite la generación de salida aunque haya errores
		"strict": false
	}
}
